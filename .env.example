# Where the portal calls the API. In production the gateway proxies /api/ to the
# backend on the same hostname, so a relative path is used (no CORS needed).
NEXT_PUBLIC_API_URL=/api/v1

# Public base URL of the object storage that serves member photos
# (same value the dashboard uses), e.g. https://silvergym-bd.com/storage/silvergym
NEXT_PUBLIC_MINIO_URL=http://localhost:9000/silvergym
